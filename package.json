{
  "name": "express-api",
  "version": "1.0.0",
  "description": "Client-Server Application Scaffolding - Express.js + MongoDB REST API with JWT authentication, ESLint, Docker, and full development toolchain. Covers VS Code configuration, Node.js platform, REST services, service improvement, and automated code quality control.",
  "main": "server.js",
  "scripts": {
    "dev": "set NODE_ENV=dev&&nodemon src/server.js",
    "prod": "set NODE_ENV=prod&&node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:src": "eslint src/",
    "lint:app": "eslint app.js server.js",
    "lint:server": "eslint src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoctisRen/Client-Server-Scaffolding.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NoctisRen/Client-Server-Scaffolding/issues"
  },
  "homepage": "https://github.com/NoctisRen/Client-Server-Scaffolding#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.19.0",
    "dotenv": "^10.0.0",
    "ejs": "^2.5.6",
    "express": "^4.17.1",
    "express-jwt": "^8.5.1",
    "helmet": "^4.6.0",
    "joi": "^17.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "monk": "^7.3.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^2.0.12"
  }
}
